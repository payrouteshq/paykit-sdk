{
  "name": "@paykit-sdk/flutterwave",
  "version": "1.0.0",
  "description": "Flutterwave provider for PayKit, supporting the v3 and v4 APIs",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "paykit": {
    "type": "provider"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --config ../../vitest.config.ts packages/flutterwave/src",
    "typecheck": "tsc --noEmit",
    "generate:types": "openapi-typescript src/v4/openapi.json -o src/v4/generated/schema.ts",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "flutterwave",
    "paykit",
    "payment",
    "payments",
    "africa",
    "typescript"
  ],
  "license": "ISC",
  "author": "Emmanuel Odii",
  "peerDependencies": {
    "@paykit-sdk/core": "^1.4.0"
  },
  "devDependencies": {
    "@paykit-sdk/core": "workspace:*",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usepaykit/paykit-sdk.git",
    "directory": "packages/flutterwave"
  },
  "homepage": "https://github.com/usepaykit/paykit-sdk/tree/main/packages/flutterwave#readme",
  "bugs": {
    "url": "https://github.com/usepaykit/paykit-sdk/issues"
  }
}
